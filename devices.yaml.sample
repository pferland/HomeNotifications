# ==============================================================================
# HomeNotifications - Device Inventory Configuration (devices.yaml)
# ==============================================================================
# Define your monitored home network devices here.
# You can add as many devices as you want, and each device can have custom monitors
# (ping, TCP/HTTP services, SSH system resources, SNMP, Prometheus, access logs).
# ==============================================================================

devices:
  # ----------------------------------------------------------------------------
  # Gateway / Router
  # ----------------------------------------------------------------------------
  - id: "gateway"
    name: "Main Gateway Router"
    ip: "192.168.1.1"
    mac: "cc:ba:bd:d2:24:71"
    tags: ["network", "core", "router"]
    monitors:
      ping:
        enabled: true
        timeout: 2.0
      services:
        - name: "Web Admin"
          type: "http"
          port: 80
          path: "/"
          expected_status: 200
          timeout: 4.0
        - name: "DNS Server"
          type: "tcp"
          port: 53
          timeout: 2.0

  # ----------------------------------------------------------------------------
  # Home Linux Server / Raspberry Pi
  # ----------------------------------------------------------------------------
  - id: "home-server"
    name: "Primary Home Server"
    ip: "192.168.1.5"
    mac: "b8:27:eb:96:17:da"
    tags: ["server", "linux", "core"]
    monitors:
      ping:
        enabled: true
        timeout: 2.0
      services:
        - name: "SSH Daemon"
          type: "tcp"
          port: 22
          timeout: 3.0
        - name: "Nextcloud Web (VHost)"
          type: "https"
          port: 443
          hostname: "cloud.mydomain.com"
          path: "/status.php"
          expected_status: 200
          check_ssl: true
          timeout: 4.0
      ssh:
        enabled: true
        port: 22
        username: "pferland"
        key_path: "~/.ssh/id_rsa"
        timeout: 8.0
        resources:
          cpu_warning_percent: 85.0
          memory_warning_percent: 90.0
          disk_warning_percent: 85.0
          disk_mounts: ["/"]
        systemd_services:
          - "docker"
          - "ssh"
        access_logs:
          auth_log_path: "/var/log/auth.log"
          check_failed_logins: true
          failed_login_threshold: 3

  # ----------------------------------------------------------------------------
  # Network Switch (Managed)
  # ----------------------------------------------------------------------------
  - id: "core-switch"
    name: "Cisco SG300 Switch"
    ip: "192.168.1.2"
    mac: "00:87:31:4c:18:ad"
    tags: ["switch", "network"]
    monitors:
      ping:
        enabled: true
        timeout: 2.0
      services:
        - name: "Switch Web GUI"
          type: "http"
          port: 80
          path: "/"
          expected_status: 200
      snmp:
        enabled: false
        community: "public"
        version: "2c"
        port: 161
        oids:
          uptime: "1.3.6.1.2.1.1.3.0"

  # ----------------------------------------------------------------------------
  # Database / Secondary Server
  # ----------------------------------------------------------------------------
  - id: "sql-server"
    name: "SQL & App Server"
    ip: "192.168.1.4"
    mac: "dc:a6:32:5c:27:2a"
    tags: ["database", "server"]
    monitors:
      ping:
        enabled: true
        timeout: 2.0
      services:
        - name: "MySQL / MariaDB"
          type: "tcp"
          port: 3306
          timeout: 3.0
        - name: "SSH"
          type: "tcp"
          port: 22
          timeout: 3.0
      prometheus:
        enabled: false
        url: "http://192.168.1.4:9100/metrics"
        timeout: 5.0
        alerts:
          node_load1: 4.0
